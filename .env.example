# ============================================================================
# resufy — Backend Environment TEMPLATE / ARSIP SEJARAH (Fase 4: KICKOFF)
# Tanggal: 2026-08-13
# ----------------------------------------------------------------------------
# ⚠️ LOKASI .env AKTIF: **backend/.env** (BUKAN root project).
#    Backend membaca env dari `backend/.env` (dotenv 2 tingkat dari
#    src/config). File ini (root `.env.example`) HANYA template/arsip —
#    dipakai sebagai referensi nama variabel, TIDAK dibaca oleh aplikasi.
# ----------------------------------------------------------------------------
# CARA PAKAI (jika env kosong/missing):
#   1. Salin file ini ke `backend/.env`:
#      - Windows PowerShell :  Copy-Item .env.example backend\.env
#      - Windows CMD        :  copy .env.example backend\.env
#      - Linux / macOS      :  cp .env.example backend/.env
#   2. Isi setiap nilai sesuai akun/layananmu (lihat komentar per baris).
#      JANGAN biarkan placeholder `change-me-*` — aplikasi akan gagal/berbahaya.
#   3. JANGAN PERNAH commit `.env` ke git. Pastikan `.gitignore` berisi
#      `.env` (dan `.env.*` kecuali `.env.example`). `.env` = rahasia.
#   4. Setelah `backend/.env` terisi lengkap (kecuali grup yang ditandai
#      TERTUNDA), konfirmasi ke orchestrator agar develop backend penuh dimulai.
# ----------------------------------------------------------------------------
# LEGENDA:
#   [WAJIB]     harus diisi sebelum develop penuh
#   [DEV/PROD]  nilai bisa berbeda antara development dan production
#   [OPSIONAL]  boleh dikosongkan / pakai default
#   [TERTUNDA]  keputusan sumber daya belum final — diisi belakangan
# ============================================================================

# ----------------------------------------------------------------------------
# A. UMUM / SERVER
# ----------------------------------------------------------------------------

# Mode aplikasi: development | production | test
# [WAJIB] [DEV: development | PROD: production]
NODE_ENV=development

# Port yang dipakai server Express.
# [WAJIB] [DEV: 4000 | PROD: dibiarkan default — hosting inject PORT]
PORT=4000

# Origin frontend (React Vite) untuk CORS. HARUS origin eksplisit, JANGAN `*`
# (cookie httpOnly lintas origin butuh allowlist origin).
# [WAJIB] [DEV: http://localhost:5173 | PROD: https://resufy.app]
CLIENT_ORIGIN=http://localhost:5173

# URL publik backend. Dipakai untuk URL absolut di email (link reset password)
# dan acuan webhook Midtrans (diatur di dashboard Midtrans, bukan di sini).
# [WAJIB] [DEV: http://localhost:4000 | PROD: https://api.resufy.app]
API_PUBLIC_URL=http://localhost:4000

# ----------------------------------------------------------------------------
# B. DATABASE (MongoDB)
# ----------------------------------------------------------------------------

# Connection string MongoDB.
# [WAJIB] [DEV: local `mongodb://localhost:27017/resufy`
#          PROD: MongoDB Atlas `mongodb+srv://<user>:<pass>@<cluster>/resufy?...`]
# Sumber: MongoDB Atlas (cloud gratis M0) ATAU instalasi MongoDB lokal.
MONGODB_URI=mongodb://localhost:27017/resufy

# ----------------------------------------------------------------------------
# C. AUTENTIKASI (JWT — asumsi provisional: disimpan di httpOnly cookie)
# ----------------------------------------------------------------------------
# Detail refresh token / CSRF ditangani fase security (05). Yang di sini cukup
# untuk develop. CARA BIKIN SECRET: Node.js -> `crypto.randomBytes(48).toString('hex')`
# atau https://randomkeygen.com — MINIMAL 32 karakter acak. Jangan pakai kata
# yang bisa ditebak. Jangan commit ke git.

# Secret untuk menandatangani JWT. [WAJIB] ≥32 karakter acak.
JWT_SECRET=change-me-generate-32-char-random

# Secret refresh token — TERPISAH dari JWT_SECRET (skill jwt-authentication):
# refresh JWT ditandatangani/diverifikasi dengan secret berbeda ini, sehingga
# kompromi access secret tidak menyentuh refresh token. [WAJIB] ≥32 karakter acak.
JWT_REFRESH_SECRET=change-me-generate-32-char-random

# Masa berlaku access token (format vercel/ms: 15m, 1h, 7d).
# [OPSIONAL, default 15m]
JWT_ACCESS_EXPIRES_IN=15m

# `true` HANYA saat production (cookie hanya dikirim lewat HTTPS).
# `false` saat develop lokal (http://localhost).
# [WAJIB] [DEV: false | PROD: true]
JWT_COOKIE_SECURE=false

# ----------------------------------------------------------------------------
# D. CLOUDINARY (penyimpanan file: PDF CV, dokumen plagiarism, avatar)
# ----------------------------------------------------------------------------
# Cara dapat: daftar gratis di https://cloudinary.com -> Dashboard menampilkan
# Cloud name, API Key, API Secret. [WAJIB untuk CV/Plagiarism/avatar]

CLOUDINARY_CLOUD_NAME=change-me-your-cloud-name
CLOUDINARY_API_KEY=change-me-your-api-key
CLOUDINARY_API_SECRET=change-me-your-api-secret

# Prefix folder di Cloudinary agar asset resufy rapi (misal: resufy/).
# [OPSIONAL]
CLOUDINARY_FOLDER_PREFIX=resufy/

# ----------------------------------------------------------------------------
# E. MIDTRANS (payment gateway — HANYA pay-per-print Rp2.000 per dokumen)
# ----------------------------------------------------------------------------
# Cara dapat: daftar di https://dashboard.sandbox.midtrans.com (sandbox) dan
# https://dashboard.midtrans.com (production). Server key & client key ada di
# menu Settings -> Access Keys (berbeda untuk sandbox vs production).
# [WAJIB — sandbox dulu untuk develop; production menyusul saat launch]

# Server Key Midtrans (RAHASIA — hanya untuk backend). [WAJIB]
MIDTRANS_SERVER_KEY=change-me-sandbox-server-key
# Client Key Midtrans (publik — aman untuk frontend/Snap.js). [WAJIB]
MIDTRANS_CLIENT_KEY=change-me-sandbox-client-key

# `true` = environment production Midtrans; `false` = sandbox.
# [WAJIB] [DEV: false | PROD: true]
MIDTRANS_IS_PRODUCTION=false

# Base URL Snap API (untuk dapat snapToken).
# Sandbox: https://app.sandbox.midtrans.com/snap/v1/transactions
# Production: https://app.midtrans.com/snap/v1/transactions
# [WAJIB — samakan dengan MIDTRANS_IS_PRODUCTION]
MIDTRANS_SNAP_BASE_URL=https://app.sandbox.midtrans.com/snap/v1/transactions

# Merchant ID (lihat di dashboard Midtrans). [OPSIONAL — dipakai untuk verifikasi
# tambahan & logging]
MIDTRANS_MERCHANT_ID=change-me-merchant-id

# CATATAN WEBHOOK: URL notifikasi Midtrans diatur di DASHBOARD Midtrans
# (Settings -> Configuration -> Payment Notification URL), bukan di file ini.
# Isi dengan: {API_PUBLIC_URL}/api/payments/webhook
# Contoh: https://api.resufy.app/api/payments/webhook

# ----------------------------------------------------------------------------
# F. WEB SEARCH API — SerpApi (untuk mesin similarity checker self-built)
# ----------------------------------------------------------------------------
# KEPUTUSAN FASE 4: penyedia = SerpApi (Google CSE ditutup utk pelanggan baru &
# Bing di-sunset — lihat memory/04-backend-nodejs.md §2 untuk alasannya).
# Cara dapat: daftar di https://serpapi.com -> API key ada di dashboard.
# Free plan ~250 pencarian/bulan; paid mulai $25/bulan (1.000 pencarian).
# [WAJIB jika fitur plagiarism aktif]

SERPAPI_API_KEY=change-me-serpapi-api-key

# Region hasil pencarian (param `gl`) — default `id` = Indonesia.
# [OPSIONAL, default id]
SERPAPI_GL=id
# Bahasa hasil pencarian (param `hl`) — default `id`.
# [OPSIONAL, default id]
SERPAPI_HL=id

# ----------------------------------------------------------------------------
# G. EMAIL / SMTP — RESET PASSWORD  [KEPUTUSAN TERTUNDA]
# ----------------------------------------------------------------------------
# Requirement membutuhkan reset password, tapi penyedia email BELUM diputuskan.
# Opsi: (a) SMTP generic (mis. Brevo/Mailtrap), (b) Resend, (c) SendGrid.
# Sampai user memutuskan, blok di bawah DIKOMENTARI — fitur reset password
# hanya bisa dikembangkan dengan stub (link dicetak ke log).
# Setelah memutuskan: uncomment blok yang dipakai, isi nilainya, lalu
# konfirmasi keputusan ke orchestrator.

# --- Opsi (a): SMTP generic ---
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USER=change-me-smtp-username
#SMTP_PASS=change-me-smtp-password
#EMAIL_FROM="resufy <no-reply@resufy.app>"

# --- Opsi (b): Resend (ganti blok (a) jika dipilih) ---
#RESEND_API_KEY=re_change-me-resend-api-key
#EMAIL_FROM="resufy <no-reply@resufy.app>"

# --- Opsi (c): SendGrid (ganti blok (a) jika dipilih) ---
#SENDGRID_API_KEY=SG.change-me-sendgrid-api-key
#EMAIL_FROM="resufy <no-reply@resufy.app>"

# ----------------------------------------------------------------------------
# H. OPSIONAL / UTILITAS
# ----------------------------------------------------------------------------

# Rate limiting global (window dalam milidetik). [OPSIONAL, default 60000 = 1 mnt]
RATE_LIMIT_WINDOW_MS=60000
# Maksimum request per window per IP. [OPSIONAL, default 100]
# Catatan: endpoint mahal (plagiarism upload, payment create, reset password)
# akan memakai limit lebih ketat — diatur di kode, bukan env ini.
RATE_LIMIT_MAX=100

# Level logging: trace | debug | info | warn | error. [OPSIONAL, default info]
LOG_LEVEL=info

# ----------------------------------------------------------------------------
# I. AI CONTENT DETECTOR - GEMINI (parafrase & deteksi AI)
# ----------------------------------------------------------------------------
# Cara dapat: daftar di https://aistudio.google.com/apikey -> buat API key.
# [OPSIONAL - tanpa key: deteksi AI pakai heuristik lokal; parafrase fallback Ollama]

# GEMINI_API_KEY=change-me-gemini-api-key
# GEMINI_MODEL=gemini-3.7-flash,gemini-flash-latest,gemini-3.6-flash

# ----------------------------------------------------------------------------
# J. FALLBACK LLM LOKAL - OLLAMA (parafrase GRATIS, offline, tanpa kunci API)
# ----------------------------------------------------------------------------
# Dipakai OTOMATIS oleh fitur Parafrase AI saat Gemini gagal (429 quota/5xx/
# timeout/tanpa kunci). Instalasi: winget install Ollama.Ollama -> ollama serve
# -> ollama pull qwen2.5:3b. [OPSIONAL - default dipakai bila variabel kosong]

# URL server Ollama (default http://127.0.0.1:11434)
# OLLAMA_URL=http://127.0.0.1:11434
# Model multibahasa ringan utk CPU. Alternatif: gemma3:4b, llama3.2:3b.
# OLLAMA_MODEL=qwen2.5:3b
# Model CPU lambat & first-load lambat -> timeout panjang (default 120 detik).
# OLLAMA_TIMEOUT_MS=120000
