# ============================================================================
# resufy — Frontend Environment Template
# ----------------------------------------------------------------------------
# CARA PAKAI:
#   1. Salin file ini menjadi `.env` di folder frontend/:  Copy-Item .env.example .env
#   2. Isi nilai sesuai environment. `.env` TIDAK pernah di-commit (di-gitignore).
#   3. Semua variabel di sini PUBLIK (aman untuk browser). Rahasia backend
#      (MIDTRANS_SERVER_KEY, CLOUDINARY_API_SECRET, JWT_SECRET) TIDAK PERNAH
#      boleh ditaruh di frontend.
# ============================================================================

# ----------------------------------------------------------------------------
# API
# ----------------------------------------------------------------------------
# Base URL API backend.
#  - Development: KOSONGKAN → dipakai proxy Vite (vite.config.js → http://localhost:4112).
#    Keuntungan: cookie httpOnly terkirim otomatis, tanpa konfigurasi CORS manual.
#  - Production: isi URL publik backend, misal: https://api.resufy.app/api
# VITE_API_URL=

# ----------------------------------------------------------------------------
# MIDTRANS (Snap.js) — hanya CLIENT KEY (publik) yang boleh di frontend
# ----------------------------------------------------------------------------
# Client Key dari dashboard Midtrans (Settings → Access Keys).
#  - Sandbox    : SB-Mid-client-...
#  - Production : MID-...  (ganti saat launch, ikuti MIDTRANS_IS_PRODUCTION)
VITE_MIDTRANS_CLIENT_KEY=

# true = environment production Midtrans (snap.js dari app.midtrans.com)
# false / kosong = sandbox (app.sandbox.midtrans.com) — cocok untuk develop
VITE_MIDTRANS_PRODUCTION=false
